# =============================================================================
# AgentOps Control Plane Environment Configuration
# =============================================================================

# Server Bind Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database Connection URL
# SQLite on disk (Local development default):
DATABASE_URL=sqlite:///agent_ops.db

# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+psycopg://agentops:agentops_secret@localhost:5432/agentops

# CORS Allowed Origins (Comma-separated or * for development)
CORS_ORIGINS=*
